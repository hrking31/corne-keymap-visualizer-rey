[
  "none",
  "rgb(140, 133, 115)",
  "rgb(209, 204, 188)",
  "rgb(217, 119, 6)",
  "rgb(230, 226, 211)",
  "rgb(255, 157, 46)",
  "rgb(26, 25, 21)",
  "rgb(26, 25, 21) rgb(26, 25, 21) rgb(26, 25, 21) rgb(217, 119, 6)",
